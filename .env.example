# VYRO Platform Environment Variables Template
# Copy this file to .env.local for local development.

# Supabase Database & Auth (Free Tier: https://supabase.com)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Cloudinary Media Storage (Free Tier: https://cloudinary.com)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=vyro_media

# WebRTC STUN / TURN Server Configuration
# STUN is 100% free from Google. TURN can be free from Metered.ca
VITE_STUN_SERVER_URL=stun:stun.l.google.com:19302
VITE_TURN_SERVER_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Application Mode
VITE_APP_ENV=development
